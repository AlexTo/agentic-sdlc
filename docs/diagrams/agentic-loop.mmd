%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 50}, "themeVariables": {"fontFamily": "Inter, system-ui, sans-serif", "fontSize": "15px", "lineColor": "#64748b", "background": "#ffffff", "textColor": "#0f172a", "titleColor": "#0f172a", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f8fafc", "clusterBorder": "#e2e8f0"}}}%%
flowchart TB
    subgraph ALL[" "]
    direction TB
    subgraph PLAN["Plan"]
        direction LR
        S("`Write and merge the spec
_Human + Speckit_`") --> I("`Issue opens
_Automation_`")
        I --> IMPL("`Developer agent implements
_OpenHands_`")
    end

    subgraph VERIFY["Agent loop: no human in between"]
        direction TB
        CI{{"CI"}} -- "passes" --> AR{{"`Reviewer agent reviews
_OpenHands_`"}}
        CI -- "fails" --> FIX("`Developer agent fixes
_OpenHands, max 5× per loop_`")
        AR -- "changes requested" --> FIX
        FIX -. "CI runs again" .-> CI
    end

    PLAN -- "tests pass locally" --> PR("Developer agent raises a PR")
    PR --> VERIFY
    VERIFY -- "CI green and Reviewer approves" --> HR{{"`Human reviews and merges the PR
_A person, does any (human) tasks_`"}}
    HR -- "merged" --> TICK{{"`Phase's agent tasks
ticked in tasks.md?
_Agent Issues_`"}}
    TICK -- "yes, a phase is left" --> NEXT("`Next phase's issue opens
_↻ back to Developer agent implements_`")
    TICK -- "yes, none left" --> Done(["Spec done"])
    TICK -- "no" --> STALL("`Comment on the PR
_a person ticks or finishes them_`")
    HR -. "changes requested<br/>+ openhands-review label" .-> VERIFY

    HR -- "main is green" --> DEPLOY("`Deploy to the development stage
_Automation, optional_`")
    DEPLOY --> TISSUE("`Test issue opens
_Automation_`")
    TISSUE --> TEST{{"`Tester agent tests the deployed change
_UI, APIs and stored data, on OpenHands_`"}}
    TEST -- "passes" --> TDONE(["Report, test issue closed"])
    TEST -- "fails" --> TFAIL("`Report, and a fix PR if the fix is small
_a person decides_`")

    end
    style ALL fill:#ffffff,stroke:#ffffff,color:#ffffff

    classDef human fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d
    classDef exception fill:#fff5f5,stroke:#ef4444,stroke-width:2px,stroke-dasharray:6 4,color:#7f1d1d
    classDef agent fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a
    classDef gate fill:#e0e7ff,stroke:#6366f1,stroke-width:2px,color:#312e81
    classDef done fill:#dcfce7,stroke:#22c55e,stroke-width:2px,color:#14532d
    class S human
    class I,IMPL,PR,FIX,NEXT,DEPLOY,TISSUE agent
    class CI,AR,TICK,TEST gate
    class HR human
    class STALL,TFAIL exception
    class Done,TDONE done
