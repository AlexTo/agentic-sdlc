%%{init: {"theme": "base", "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 50}, "themeVariables": {"fontFamily": "Inter, system-ui, sans-serif", "fontSize": "15px", "lineColor": "#64748b", "background": "#ffffff", "textColor": "#0f172a", "titleColor": "#0f172a", "edgeLabelBackground": "#ffffff", "clusterBkg": "#f8fafc", "clusterBorder": "#e2e8f0"}}}%%
flowchart TB
    subgraph ALL[" "]
    direction TB
    subgraph PLAN["Plan"]
        direction LR
        S("`Write the spec
_Human + Speckit_`") --> M1("Merge the spec PR")
        M1 --> I("`Issue opens
_Automation_`")
        I --> IMPL("`Agent implements
_OpenHands_`")
    end

    subgraph VERIFY["Agent loop: no human in between"]
        direction TB
        CI{{"CI"}} -- "passes" --> AR{{"`Agent review
_OpenHands_`"}}
        CI -- "fails" --> FIX("`Agent fixes
_OpenHands, max 5× per loop_`")
        AR -- "changes requested" --> FIX
        FIX -. "CI runs again" .-> CI
    end

    PLAN -- "tests pass locally" --> PR("Agent raises a PR")
    PR --> VERIFY
    VERIFY -- "CI green and agent approves" --> HR{{"`Human review
_Developer, does any (human) tasks_`"}}
    HR -- "approves" --> MERGED("Merge the PR")
    MERGED --> TICK{{"`Phase's agent tasks
ticked in tasks.md?
_Agent Issues_`"}}
    TICK -- "yes, a phase is left" --> NEXT("`Next phase's issue opens
_↻ back to Agent implements_`")
    TICK -- "yes, none left" --> Done(["Spec done"])
    TICK -- "no" --> STALL("`Comment on the PR
_a person ticks or finishes them_`")
    HR -. "changes requested<br/>+ openhands-review label" .-> VERIFY

    end
    style ALL fill:#ffffff,stroke:#ffffff,color:#ffffff

    classDef human fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d
    classDef agent fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a
    classDef gate fill:#e0e7ff,stroke:#6366f1,stroke-width:2px,color:#312e81
    classDef done fill:#dcfce7,stroke:#22c55e,stroke-width:2px,color:#14532d
    class S,M1 human
    class I,IMPL,PR,FIX,NEXT agent
    class CI,AR,TICK gate
    class HR,MERGED,STALL human
    class Done done
