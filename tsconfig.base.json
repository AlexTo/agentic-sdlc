{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@agentic-sdlc/source"
    ],
    "rootDir": ".",
    "paths": {
      "@agentic-sdlc/notes-table": [
        "./packages/notes-table/src/index.ts"
      ],
      "@agentic-sdlc/notes-api": [
        "./packages/notes-api/src/index.ts"
      ],
      "@agentic-sdlc/notes-website": [
        "./packages/notes-website/src/index.ts"
      ],
      "@agentic-sdlc/common-shadcn": [
        "./packages/common/shadcn/src/index.ts"
      ],
      "@agentic-sdlc/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ]
    }
  }
}
